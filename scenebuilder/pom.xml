<?xml version="1.0" encoding="UTF-8"?>
<!-- Standalone designer preview build, no JInvFore legacy or corporate parent. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>
   <groupId>ru.inversion</groupId>
   <artifactId>fore25-scenebuilder</artifactId>
   <version>0.2.0-SNAPSHOT</version>
   <properties>
      <maven.compiler.release>25</maven.compiler.release>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
   </properties>
   <dependencies>
      <dependency>
         <groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>25.0.4</version>
      </dependency>
      <dependency>
         <groupId>org.openjfx</groupId><artifactId>javafx-fxml</artifactId><version>25.0.4</version>
      </dependency>
      <dependency>
         <groupId>org.controlsfx</groupId><artifactId>controlsfx</artifactId><version>11.2.4</version>
      </dependency>
      <dependency>
         <groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.14.4</version><scope>test</scope>
      </dependency>
   </dependencies>
   <build>
      <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
      <testSourceDirectory>${project.basedir}/../src/test/java</testSourceDirectory>
      <resources>
         <resource>
            <directory>${project.basedir}/../src/main/resources</directory>
            <includes>
               <include>ru/inversion/fore/form/action/actions.properties</include>
               <include>style/*.ttf</include>
            </includes>
         </resource>
      </resources>
      <plugins>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
            <configuration>
               <includes>
                  <include>ru/inversion/fore/form/action/*.java</include>
                  <include>ru/inversion/fore/form/control/ForeButton.java</include>
                  <include>ru/inversion/fore/form/control/ForeMenuItem.java</include>
                  <include>ru/inversion/fore/form/control/ForeToolBar.java</include>
               </includes>
               <testIncludes>
                  <testInclude>ru/inversion/fore/form/action/ForeActionsTest.java</testInclude>
                  <testInclude>ru/inversion/fore/form/action/IconSpecTest.java</testInclude>
                  <testInclude>ru/inversion/fore/form/action/ForeSceneBuilderContractTest.java</testInclude>
               </testIncludes>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
         </plugin>
      </plugins>
   </build>
</project>
