<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.*?>
<?import ru.inversion.fx.form.controls.*?>
<AnchorPane id="AnchorPane" prefWidth="400.0" xmlns="http://javafx.com/javafx/8.0.40" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.inversion.fx.form.controls.filter.impl.ManageParamController">
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
   <children>
      <GridPane prefWidth="400.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="185.0" />
          <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="ALWAYS" />
        </rowConstraints>
         <children>
            <HBox alignment="CENTER_RIGHT" fillHeight="false" spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="5">
               <children>
                  <JInvButton fx:id="btOK" minWidth="70.0" mnemonicParsing="false"/>
                  <JInvButton fx:id="btCancel" minWidth="70.0" mnemonicParsing="false"/>
               </children>
            </HBox>
            <JInvTextField fx:id="edNum" fieldName="IPARAMNUM" prefColumnCount="6" GridPane.columnIndex="1" />
            <JInvTextField fx:id="edName" fieldName="CPARAMDESCR" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <JInvTextField fx:id="edValue" fieldName="CPARAMDEFAULT" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <JInvLabel linkFieldName="edNum" text="%PARAM.NUM" />
            <JInvLabel linkFieldName="edName" text="%PARAM.NAME" GridPane.rowIndex="1" />
            <JInvLabel linkFieldName="edValue" text="%PARAM.VALUE" GridPane.rowIndex="2" />
            <JInvTextField fx:id="edCursor" fieldName="IDCURSOR" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <JInvLabel linkFieldName="IDCURSOR" text="%FILTER_LIST_PANE.COL_IDCURSOR" GridPane.rowIndex="3" />
            <JInvLabel linkFieldName="BPARAMSAVE" text="%FILTER_LIST_PANE.COL_BPARAMSAVE" GridPane.rowIndex="4" />
            <JInvCheckBox fx:id="edSave" fieldName="BPARAMSAVE" GridPane.columnIndex="1" GridPane.rowIndex="4" />
         </children>
      </GridPane>
   </children>
</AnchorPane>
