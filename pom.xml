<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    Временно сохраняем корпоративный parent:
    - внутренние Maven repositories / distributionManagement;
    - управляемые версии части библиотек.
    Критичные для Fore25 build plugins и версии переопределены ниже явно.
  -->
  <parent>
    <groupId>ru.inversion</groupId>
    <artifactId>inversion-parent</artifactId>
    <version>1</version>
    <relativePath/>
  </parent>

  <artifactId>fore25</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Fore25</name>
  <description>
    Java 25 / JavaFX 25 generation of the JInvFore rich-client framework.
    Compatibility-first migration project.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Target platform -->
    <maven.compiler.release>25</maven.compiler.release>
    <javafx.version>25.0.4</javafx.version>

    <!-- JavaFX ecosystem -->
    <controlsfx.version>11.2.4</controlsfx.version>
    <richtextfx.version>0.11.7</richtextfx.version>
    <!-- Tests: stay on JUnit 5 while preserving existing JUnit 4 tests -->
    <junit.version>5.14.4</junit.version>
    <junit4.version>4.13.2</junit4.version>

    <!--
      No SVN/buildnumber plugin in Fore25.
      CI/release build may inject a Git revision:
          mvn -Dscm.revision=<git-sha> ...
    -->
    <scm.revision>DEV</scm.revision>

    <!-- Existing corporate parent property -->
    <inversion.embed.sources.skip>true</inversion.embed.sources.skip>
  </properties>

  <!--
    Pin the whole JavaFX family to one patch level.
    This protects the build from accidental JavaFX version skew introduced
    by ControlsFX / RichTextFX / other transitive dependencies.
  -->

  <!--
    Explicit corporate Nexus configuration.

    These entries intentionally duplicate settings inherited from inversion-parent.
    Fore25 must resolve the same way even when a developer/IDE uses a different
    Maven installation or settings.xml.
  -->
  <repositories>
    <repository>
      <id>inversion-maven-public</id>
      <name>Inversion Nexus - Maven Public</name>
      <url>http://vcontrol:8081/repository/maven-public/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <pluginRepositories>
    <!-- Internal company Maven plugins. -->
    <pluginRepository>
      <id>inversion-maven-plugins-releases</id>
      <name>Inversion Nexus - Maven Plugins Releases</name>
      <url>http://vcontrol:8081/repository/inversion-maven-plugins-releases/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </pluginRepository>

    <!--
      Also expose the Nexus public group for standard Maven plugins.
      This is useful when the Maven installation does not have the old
      corporate mirror configuration in settings.xml.
    -->
    <pluginRepository>
      <id>inversion-maven-public-plugins</id>
      <name>Inversion Nexus - Maven Public (plugins)</name>
      <url>http://vcontrol:8081/repository/maven-public/</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </pluginRepository>
  </pluginRepositories>

