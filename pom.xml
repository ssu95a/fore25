  <build>
    <finalName>fore25</finalName>

    <plugins>

      <!-- The parent POM contains very old lifecycle plugin versions.
           Fore25 pins the plugins used by the migration build explicitly. -->

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>fore25-build-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,4.0.0)</version>
                  <message>Fore25 requires Maven 3.9.x. Maven itself may run on Java 8; compilation/tests use the JDK 25 toolchain.</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>${maven.compiler.release}</release>
          <jdkToolchain>
            <version>25</version>
          </jdkToolchain>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- Initial migration is deliberately non-JPMS. -->
          <useModulePath>false</useModulePath>
          <jdkToolchain>
            <version>25</version>
          </jdkToolchain>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <archive>
            <addMavenDescriptor>false</addMavenDescriptor>
            <manifestEntries>
              <SCM-Revision>${scm.revision}</SCM-Revision>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>

    </plugins>
  </build>

  <profiles>

    <!--
      TEMPORARY compatibility profile.

      The Java 8 JInvFore build unpacked direct ru.inversion / ru.inversion.tools
      dependencies into JInvFore.jar. Some production consumers may therefore
      depend on classes that were physically embedded into that JAR.

      Do NOT treat this as the target Fore25 packaging architecture.
      This profile exists only to build/drop-test an artifact comparable to the
      legacy JInvFore.jar while binary compatibility is being measured.

      Usage:
          mvn -Plegacy-jar -Dscm.revision=<git-sha> clean package
    -->
    <profile>
      <id>legacy-jar</id>

      <build>
        <finalName>JInvFore</finalName>

        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>unpack-inversion-dependencies</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                  <excludeTransitive>true</excludeTransitive>
                  <includeGroupIds>ru.inversion,ru.inversion.tools</includeGroupIds>
                  <excludeArtifactIds>ijdbc,crypto-etoken,FXbicomp</excludeArtifactIds>
                  <excludes>source/</excludes>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.5.1</version>
            <configuration>
              <archive>
                <addMavenDescriptor>false</addMavenDescriptor>
                <manifest>
                  <classpathPrefix>lib/</classpathPrefix>
                  <addClasspath>true</addClasspath>
                  <classpathLayoutType>custom</classpathLayoutType>
                  <customClasspathLayout>$${artifact.artifactId}.$${artifact.extension}</customClasspathLayout>
                </manifest>
                <manifestEntries>
                  <!-- Preserved from the legacy JInvFore manifest for compatibility testing. -->
                  <Class-Path>lib/jsr305.jar crypto-etoken.jar lib/ijdbc.jar lib/commons-beanutils.jar lib/dynamicreports-adhoc.jar lib/xmlgraphics-commons.jar lib/dynamicreports-core.jar lib/itext.jar lib/jasperreports.jar lib/castor-core.jar lib/castor-xml.jar lib/ecj.jar lib/jfreechart.jar lib/jcommon.jar lib/commons-digester.jar lib/jasperreports-fonts.jar lib/SparseBitSet.jar lib/commons-math3.jar</Class-Path>
                  <SCM-Revision>${scm.revision}</SCM-Revision>
                </manifestEntries>
              </archive>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

